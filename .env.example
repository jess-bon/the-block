# Local Postgres connection.
#
# macOS (Homebrew) — Postgres creates a role matching your OS username with no
# password, so this is usually all you need after `createdb the_block`:
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/the_block?schema=public"

# Linux / postgres.app / a password-protected install:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_block?schema=public"
